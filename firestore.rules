rules_version = '2';
// Site Manager (Veershree) — security rules, Phase 1
// Paste this whole file in Firebase console → Firestore Database → Rules → Publish.
// Roles: admin (everything), manager (own sites, own cash book, cannot touch approved entries),
//        accountant (sees everything, marks bills paid, records payments), viewer (read only).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function active() { return signedIn() && exists(userPath()) && me().active == true; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function isManager() { return active() && me().role == 'manager'; }
    function isAccountant() { return active() && me().role == 'accountant'; }
    function seesAll() { return active() && me().role in ['admin', 'accountant', 'viewer']; }
    function myPerson() { return me().get('person', ''); }
    function managesSite(siteId) { return isManager() && siteId in me().get('sites', []); }
    function ownerPath() { return /databases/$(database)/documents/config/owner; }
    function isOwner() { return exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid; }

    // every write carries the server time and the writer's id
    function stamped() { return request.resource.data._u == request.time && request.resource.data._ub == request.auth.uid; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function cleanNew() {
      let d = request.resource.data;
      return stamped() && d._by == request.auth.uid && !('_del' in d);
    }
    // a manager may change a not-yet-approved entry; it stays pending and keeps who made it
    function managerEdit() {
      let d = request.resource.data;
      return stamped() && resource.data.get('_appr', '') != 'approved' && resource.data.get('_del', false) != true
        && d._appr == 'pending' && d._by == resource.data._by && d._c == resource.data._c && !('_del' in d)
        && !changedKeys().hasAny(['_apBy', '_apByName', '_apAt', '_by', '_byName', '_at', '_s', '_i']);
    }

    // set once by the first person who opens the app (the owner)
    match /config/owner {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && uid == request.auth.uid && isOwner()
            && request.resource.data.role == 'admin' && request.resource.data.active == true);
      // an admin cannot remove their own admin rights or switch themselves off
      allow update: if isAdmin() && !(uid == request.auth.uid
        && (request.resource.data.role != 'admin' || request.resource.data.active != true));
      allow delete: if false;
    }

    // managers list, delete password, logos: everyone reads, only the admin changes
    match /sm_meta/{docId} {
      allow read: if active();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;
    }

    // one site: name, machines, rates, masters, settings
    match /sm_sites/{siteId} {
      allow read: if seesAll() || managesSite(siteId);
      allow create: if isAdmin() && stamped();
      allow update: if (isAdmin() && stamped())
        || (managesSite(siteId) && stamped() && !('_del' in request.resource.data) && request.resource.data.id == resource.data.id);
      allow delete: if false;

      match /entries/{docId} {
        allow read: if seesAll() || managesSite(siteId);
        allow create: if (isAdmin() && stamped())
          || (managesSite(siteId) && cleanNew() && request.resource.data._appr == 'pending' && request.resource.data._s is string)
          || (isAccountant() && cleanNew() && request.resource.data._appr == 'approved'
              && request.resource.data._c in ['vendorPayments', 'ownerPayments', 'funds']);
        allow update: if (isAdmin() && stamped())
          || (managesSite(siteId) && managerEdit())
          // the accountant may only mark an expense, diesel or murum bill paid, or record payments on a rent bill
          || (isAccountant() && stamped() && resource.data.get('_del', false) != true
              && ((resource.data._c in ['expenseLog', 'dieselLog', 'murumLog'] && changedKeys().hasOnly(['status', 'paidBy', 'mode', '_u', '_ub', '_ubName']))
               || (resource.data._c == 'bills' && changedKeys().hasOnly(['payments', '_u', '_ub', '_ubName']))));
        allow delete: if false;
      }
    }

    // money given to a manager (the manager's cash book)
    match /sm_mfunds/{docId} {
      allow read: if seesAll() || (isManager() && myPerson() != '' && resource.data.manager == myPerson());
      allow create: if (isAdmin() && stamped())
        || (isAccountant() && cleanNew() && request.resource.data._appr == 'approved')
        || (isManager() && myPerson() != '' && cleanNew() && request.resource.data.manager == myPerson() && request.resource.data._appr == 'pending');
      allow update: if (isAdmin() && stamped())
        || (isManager() && myPerson() != '' && resource.data.manager == myPerson()
            && request.resource.data.manager == myPerson() && managerEdit());
      allow delete: if false;
    }
  }
}
