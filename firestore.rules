rules_version = '2';
// Veershree Plot Expense Manager — security rules (Phase 1)
// Paste this whole file in Firebase console → Firestore Database → Rules → Publish.
// Roles: admin (everything), manager (own sites, own cash book, cannot touch approved entries),
//        accountant (sees everything, marks bills paid, records payments), viewer (read only).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function active() { return signedIn() && exists(userPath()) && me().active == true; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function isManager() { return active() && me().role == 'manager'; }
    function isAccountant() { return active() && me().role == 'accountant'; }
    function seesAll() { return active() && me().role in ['admin', 'accountant', 'viewer']; }
    function myPerson() { return me().get('person', ''); }
    function managesSite(siteId) { return isManager() && siteId in me().get('sites', []); }
    function ownerPath() { return /databases/$(database)/documents/config/owner; }
    function isOwner() { return exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid; }

    // every write must carry the server time and the writer's id
    function stamped() {
      return request.resource.data._u == request.time && request.resource.data._ub == request.auth.uid;
    }
    function newEntry(siteId) {
      let d = request.resource.data;
      return stamped() && d._by == request.auth.uid && d.id is string
        && d._c in ['exp', 'mlog', 'dsl', 'vpay', 'opay', 'bill']
        && (siteId == '_nosite' || d.site == siteId)
        && !('_del' in d) && !('_movedTo' in d);
    }
    function newFund() {
      let d = request.resource.data;
      return stamped() && d._by == request.auth.uid && d.id is string && d._c == 'fund'
        && !('_del' in d) && !('_movedTo' in d);
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // a manager may edit their own team's entry only while it is not approved, and it stays pending
    function managerEdit() {
      let d = request.resource.data;
      return stamped() && resource.data.get('_appr', '') != 'approved' && resource.data.get('_del', false) != true
        && d._appr == 'pending' && d._by == resource.data._by && d._c == resource.data._c
        && d.get('site', '') == resource.data.get('site', '') && !('_del' in d)
        && !changedKeys().hasAny(['_apBy', '_apByName', '_apAt', '_by', '_byName', '_at']);
    }

    // set once by the first person who opens the app (the owner)
    match /config/owner {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && uid == request.auth.uid && isOwner()
            && request.resource.data.role == 'admin' && request.resource.data.active == true);
      // an admin cannot remove their own admin rights or switch themselves off (prevents lock-out)
      allow update: if isAdmin() && !(uid == request.auth.uid
        && (request.resource.data.role != 'admin' || request.resource.data.active != true));
      allow delete: if false;
    }

    // sites, people, expense heads, machines and settings: everyone reads, only admin changes
    match /meta/{docId} {
      allow read: if active();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;
    }

    match /sites/{siteId}/entries/{docId} {
      allow read: if seesAll() || managesSite(siteId)
        || (isManager() && myPerson() != '' && resource.data.paidBy == myPerson());

      allow create: if (isAdmin() && stamped())
        || (managesSite(siteId) && newEntry(siteId) && request.resource.data._appr == 'pending')
        || (isAccountant() && newEntry(siteId) && request.resource.data._c in ['vpay', 'opay']
            && request.resource.data._appr == 'approved');

      allow update: if (isAdmin() && stamped())
        || (managesSite(siteId) && managerEdit())
        // the accountant may only mark an expense or diesel bill as paid / unpaid
        || (isAccountant() && stamped() && resource.data._c in ['exp', 'dsl'] && resource.data.get('_del', false) != true
            && changedKeys().hasOnly(['status', 'paidBy', 'mode', '_u', '_ub', '_ubName']));

      allow delete: if isAdmin();
    }

    match /funds/{docId} {
      allow read: if seesAll() || (isManager() && myPerson() != '' && resource.data.person == myPerson());
      allow create: if (isAdmin() && stamped())
        || (isAccountant() && newFund() && request.resource.data._appr == 'approved')
        || (isManager() && myPerson() != '' && newFund() && request.resource.data.person == myPerson()
            && request.resource.data._appr == 'pending');
      allow update: if (isAdmin() && stamped())
        || (isManager() && myPerson() != '' && resource.data.get('person', '') == myPerson()
            && request.resource.data.person == myPerson() && managerEdit());
      allow delete: if isAdmin();
    }
  }
}
